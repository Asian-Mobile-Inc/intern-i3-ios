                            <constraint firstAttribute="trailing" secondItem="authorLabel-id" secondAttribute="trailing" constant="12" id="c10"/>
                            <constraint firstAttribute="bottom" secondItem="authorLabel-id" secondAttribute="bottom" constant="12" id="c11"/>
                        </constraints>
                        <userDefinedRuntimeAttributes>
